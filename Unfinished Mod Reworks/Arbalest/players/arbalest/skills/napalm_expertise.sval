%include "players/skills_cost.inc"
<dict>
	<string name="name">Napalm Expertise</string>
	<string name="type-name">.skills.type.passive</string>
	<string name="description">Fire damage is increased by 5%. Fire hits have a 10% chance to weaken enemies.</string>
	<array name="description-params">
		<array><s>fire-damage</s><s>Fire damage</s><s>+5%</s></array>
		<array><s>chance</s><s>.skills.desc.params.chance</s><s>10%</s></array>
	</array>

	<array name="icon">
		<string>players/arbalest/icons_skills.png</string>
		<int>100</int><vec4>0 24 24 24</vec4>
	</array>

	<string name="id">arbalest_napalm_expertise</string>
	<array name="tags"><s>passive</s><s>fire</s></array>
	<int name="starting-level">1</int>

	<dict name="skill">
		<int name="skill-cost">SKILLCOSTLEVEL_1</int>
		<string name="class">Skills::PassiveSkill</string>
		<dict name="binds">
			<float name="fire-dmg">0.05</float>
			<float name="weaken-chance">0.1</float>
			<string name="weakness-buff">tweak/buffs/status_effects.sval:weakness</string>
		</dict>
		<array name="modifiers">
			<array>
				<dict>
					<string name="class">Modifiers::DamageMulAdd</string>
					<string name="fire-bind">fire-dmg</string>
				</dict>
				<dict>
					<string name="class">Modifiers::SkillTriggerEffect</string>
					<string name="trigger">hit</string>
					<array name="skill-tags"><s>fire</s></array>
					<bool name="target-self">false</bool>
					<string name="chance-bind">weaken-chance</string>
					<int name="timeout">0</int>
					<array name="effects">
						<dict><bool name="only-actors">true</bool></dict>
						<dict>
							<string name="class">ApplyBuff</string>
							<string name="buff-bind">weakness-buff</string>
						</dict>
					</array>
				</dict>
				<dict>
					<string name="class">Modifiers::SkillTriggerEffect</string>
					<string name="trigger">spellhit</string>
					<array name="skill-tags"><s>fire</s></array>
					<bool name="target-self">false</bool>
					<string name="chance-bind">weaken-chance</string>
					<int name="timeout">0</int>
					<array name="effects">
						<dict><bool name="only-actors">true</bool></dict>
						<dict>
							<string name="class">ApplyBuff</string>
							<string name="buff-bind">weakness-buff</string>
						</dict>
					</array>
				</dict>
			</array>
		</array>
	</dict>

	<array name="modifier-skills">
		<dict>
			<string name="name">Hotter Charges</string>
