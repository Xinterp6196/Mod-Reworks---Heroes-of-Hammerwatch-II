%include "players/skills_cost.inc"
<dict>
	<string name="name">Loaded for Bear</string>
	<string name="type-name">.skills.type.spell</string>
	<string name="description">.skills.ranger.spell_1.desc</string>
	<array name="shown-icons"><s>marked</s></array>

	<array name="description-params">
		<array><s>damage</s><s>.skills.desc.params.damage</s><s>40</s><s>50</s><s>60</s><s>70</s><s>80</s></array>
		<array><s>damage</s><s>.skills.desc.params.damage</s><s>+10%</s><s>+10%</s><s>+15%</s><s>+15%</s><s>+20%</s></array>
		<array><s>mana-cost</s><s>.skills.desc.params.mana_cost</s><s>20</s><s>20</s><s>25</s><s>25</s><s>30</s></array>
		<array><s>cooldown</s><b>t</b><s>.skills.desc.params.cooldown</s><s>2s</s></array>
	</array>

	<array name="icon">
		<string>players/arbalest/icons_skills.png</string>
		<int>100</int><vec4>0 0 24 24</vec4>
	</array>

	<string name="id">arbalest_loaded_for_bear</string>
	<string name="type">spell</string>
	<array name="tags"><s>spell</s><s>physical</s><s>bow</s></array>
	<int name="starting-level">1</int>

	<dict name="skill">
		<int name="skill-cost">SKILLCOSTLEVEL_1</int>
		<string name="class">Skills::ShootProjectileTarget</string>
		<string name="anim">attack</string>
		<int name="anim-length">400</int>
		<string name="snd">event:/sfx/player/classes/ranger/marked_shot/marked_shot_cast</string>
		
		<int name="cooldown">2000</int>
		<int name="castpoint">100</int>
		<float name="cast-speed-mul">1</float>
		<float name="move-speed-mul">0</float>
		<ivec2 name="move-speed">0 100</ivec2>
		<bool name="blocking">false</bool>
		<bool name="repeating">false</bool>

		<int name="radius">48</int>
		<int name="range">180</int>
		<int name="range-min">16</int>
		<bool name="raycast-to-target">false</bool>
		<string name="projectile">players/ranger/projectiles/marked_shot_arrow.unit</string>
		<int name="dist">10</int>

		<int name="mana-cost">20</int>

		<dict name="binds">
			<int name="proj-dmg">40</int>
			<float name="dmg-mul">1.1</float>
		</dict>
		
		<array name="modifiers">
			<array>
				<dict>
					<array name="conditional">
						<s>buff</s><s>has tag</s><s>marked</s>
					</array>
					
					<string name="class">Modifiers::Damage</string>
					<string name="attack-mul-bind">dmg-mul</string>
					<string name="spell-mul-bind">dmg-mul</string>
				</dict>
			</array>
		</array>
	</dict>

	<array name="upgrades">
