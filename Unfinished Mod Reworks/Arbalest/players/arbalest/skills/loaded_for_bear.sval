					<dict name="binds">
						<float name="heavy-dmg">0.06</float>
					</dict>
				</dict>
			</array>
		</dict>

		<dict>
			<string name="name">Thrill of the Hunt</string>
			<string name="description">Killing a marked enemy has a 40% chance to restore 3/4/5% of your maximum health and mana.</string>
			<array name="shown-icons"><s>marked</s></array>

			<array name="description-params">
				<array><s>regain</s><s>.skills.desc.params.restore.health.max</s><s>3%</s><s>4%</s><s>5%</s></array>
				<array><s>regain</s><s>.skills.desc.params.restore.mana.max</s><s>3%</s><s>4%</s><s>5%</s></array>
				<array><s>chance</s><s>.skills.desc.params.chance</s><s>40%</s></array>
			</array>

			<array name="icon">
				<string>players/arbalest/icons_skills.png</string>
				<int>100</int><vec4>0 0 24 24</vec4>
			</array>

			<string name="id">arbalest_loaded_for_bear_kill</string>
			<string name="quality">uncommon</string>

			<dict name="skill">
				<dict name="binds">
					<float name="kill-mana-amount">0.03</float>
					<float name="kill-heal-amount">0.03</float>
