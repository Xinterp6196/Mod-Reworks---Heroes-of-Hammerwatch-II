					</array>
					<array>
						<null />
					</array>
		 			<array>
						<dict>
							<array name="conditional">
								<s>buff</s><s>has tag</s><s>marked</s>
							</array>
							
							<string name="class">Modifiers::TriggerEffect</string>
							<string name="trigger">kill</string>
							<bool name="target-self">true</bool>
							<!-- <float name="chance">1</float> -->
							<string name="chance-bind">heal-chance</string>
							<int name="timeout">0</int>

							<array name="effects">
								<dict>
									<string name="class">DebugLog</string>
									<string name="text">test_mark_kill</string>
								</dict>
								<dict>
									<bool name="target-self">true</bool>
								</dict>
								<dict>
									<string name="class">GivePercentageMana</string>
									<string name="mana-bind">kill-mana-amount</string>
									<bool name="curr-mana">false</bool>
								</dict>
								<dict>
									<string name="class">HPBasedHeal</string>
									<string name="heal-bind">kill-heal-amount</string>
									<bool name="curr-hp">false</bool>
								</dict>
							</array>
						</dict>
					</array>
				</array>
			</dict>

			<array name="upgrades">
