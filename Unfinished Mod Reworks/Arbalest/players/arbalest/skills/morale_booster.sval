%include "players/skills_cost.inc"
<dict>
	<string name="name">Morale Booster</string>
	<string name="type-name">.skills.type.spell</string>
	<string name="description">Allies Within Range Gain Increased Spell and Weapon Power</string>

	<array name="description-params">
		<array><s>power</s><s>power</s><s>4%</s><s>8%</s><s>12%</s><s>16%</s><s>20%</s></array>
		<array><s>duration</s><b>t</b><s>.skills.desc.params.duration</s><s>12s</s></array>
		<array><s>mana-cost</s><s>.skills.desc.params.mana_cost</s><s>20</s><s>20</s><s>30</s><s>30</s><s>40</s></array>
		<array><s>cooldown</s><b>t</b><s>.skills.desc.params.cooldown</s><s>4s</s></array>
	</array>

	<array name="icon">
		<string>players/arbalest/icons_skills.png</string>
		<int>100</int><vec4>72 24 24 24</vec4>
	</array>

	<string name="id">arbalest_morale_booster</string>
	<string name="type">spell</string>
	<array name="tags"><s>spell</s></array>
	<int name="starting-level">1</int>

	<dict name="skill">
		<int name="skill-cost">SKILLCOSTLEVEL_1</int>
		<string name="class">Skills::PlayerSkillDirectional</string>
		<string name="anim">cast</string>
		<int name="anim-length">600</int>
		
		<int name="cooldown">4000</int>
		<int name="castpoint">150</int>
		<float name="cast-speed-mul">1</float>
		<float name="move-speed-mul">0.7</float>
		<ivec2 name="move-speed">0 250</ivec2>
		<ivec2 name="blocking">0 250</ivec2>
		<bool name="repeating">false</bool>

		<int name="mana-cost">20</int>

		<dict name="binds">
			<string name="com-buff">players/arbalest/buffs_arbalest.sval:arbalest_morale_1</string>
			<int name="shout-dmg">0</int>
			<int name="echo-stacks">0</int>
			<float name="weak-chance">0</float>
		</dict>
		
		<dict name="actions">
			<array name="pre">
				<dict>
					<string name="class">SpawnEffect</string>
					<string name="effect">players/warrior/effects/warcry.effect</string>
					<bool name="attach-to-owner">true</bool>
				</dict>
			</array>
			<array name="cast">
				<dict>
					<string name="class">PlaySound</string>
					<string name="sound">event:/sfx/player/classes/warrior/war_cry/war_cry</string>
				</dict>
				<dict>
					<string name="class">Explode</string>
					<string name="fx">players/warrior/effects/warcry_area.effect</string>
					<!-- <string name="fx">effects/generic/other/trap_indicator.effect?radius=100&colorg=1&colorb=1</string> -->
					<int name="radius">120</int>
					<int name="min-radius">100</int>
					<float name="dist-scaling">1000</float>

					<bool name="hit-self">true</bool>
					<bool name="hit-same-team">true</bool>
					<bool name="hit-different-team">true</bool>
					
					<array name="effects">
						<dict>
							<float name="self-dmg">1</float>
							<float name="team-dmg">1</float>
							<float name="enemy-dmg">0</float>
							<bool name="only-actors">false</bool>
						</dict>
						<dict>
							<string name="class">ApplyBuff</string>
							<string name="buff-bind">com-buff</string>
						</dict>
						<dict>
							<float name="self-dmg">0</float>
							<float name="team-dmg">0</float>
							<float name="enemy-dmg">1</float>
							<bool name="only-actors">false</bool>
						</dict>
						<dict>				
				<string name="class">AddStacks</string>
				<string name="buff">players/arbalest/stacks_footmen.sval:arbalest_echo</string>
				<string name="stacks-bind">echo-stacks</string>
				<float name="chance">1.0</float>
				<bool name="target-self">false</bool>
						</dict>
						<dict>
							<string name="class">Damage</string>
							<string name="physical-bind">shout-dmg</string>
						</dict>
						<dict>
							<string name="class">ApplyBuff</string>
							<string name="buff">tweak/buffs/status_effects.sval:weakness</string>
							<string name="chance-bind">weak-chance</string>
						</dict>
					</array>
				</dict>
			</array>
		</dict>
			
		<array name="timeline">
			<i>0</i><s>pre</s>
			<i>150</i><s>cast</s>
		</array>
	</dict>

	<array name="upgrades">
		<dict>
			<int name="skill-cost">SKILLCOSTLEVEL_2</int>
			<int name="mana-cost">20</int>
			<dict name="binds">
				<string name="com-buff">players/arbalest/buffs_arbalest.sval:arbalest_morale_2</string>
			</dict>
		</dict>
		<dict>
			<int name="skill-cost">SKILLCOSTLEVEL_3</int>
			<int name="mana-cost">30</int>
			<dict name="binds">
				<string name="com-buff">players/arbalest/buffs_arbalest.sval:arbalest_morale_3</string>
			</dict>
		</dict>
		<dict>
			<int name="skill-cost">SKILLCOSTLEVEL_4</int>
			<int name="mana-cost">30</int>
			<dict name="binds">
				<string name="com-buff">players/arbalest/buffs_arbalest.sval:arbalest_morale_4</string>
			</dict>
		</dict>
		<dict>
			<int name="skill-cost">SKILLCOSTLEVEL_5</int>
			<int name="mana-cost">40</int>
			<dict name="binds">
				<string name="com-buff">players/arbalest/buffs_arbalest.sval:arbalest_morale_5</string>
			</dict>
		</dict>
	</array>

	<array name="modifier-skills">
		<dict>
			<string name="name">Shout Can Hit Too</string>
			<string name="description">Shout Deals Damage</string>

			<array name="description-params">
				<array><s>Damage</s><s>damage</s><s>50</s><s>100</s><s>150</s></array>
			</array>

			<array name="icon">
				<string>players/arbalest/icons_skills.png</string>
				<int>100</int><vec4>72 24 24 24</vec4>
			</array>

			<string name="id">arbalest_morale_booster_damage</string>

			<dict name="skill">
				<dict name="binds">
					<int name="shout-dmg">50</int>
				</dict>

			</dict>

			<array name="upgrades">
				<dict>
					<string name="quality">uncommon</string>
					<dict name="binds">
						<int name="shout-dmg">100</int>
					</dict>
				</dict>
				<dict>
					<string name="quality">rare</string>
					<dict name="binds">
						<int name="shout-dmg">150</int>
					</dict>
				</dict>

			</array>
		</dict>

			
		<dict>
			<string name="name">Hit You Less Hard</string>
			<string name="description">Shout Can Cause Weakness On Foes</string>

			<array name="description-params">
				<array><s>Weakness</s><s>chance</s><s>50%</s><s>100%</s></array>
			</array>

			<array name="icon">
				<string>players/arbalest/icons_skills.png</string>
				<int>100</int><vec4>72 24 24 24</vec4>
			</array>

			<string name="id">arbalest_morale_booster_weakness</string>

			<dict name="skill">
				<dict name="binds">
					<float name="weak-chance">0.5</float>
				</dict>

			</dict>

			<array name="upgrades">
				<dict>
					<string name="quality">uncommon</string>
					<dict name="binds">
						<float name="weak-chance">1.0</float>
					</dict>
				</dict>
			</array>
		</dict>
		<dict>
			<string name="name">Make Ears Hurt</string>
			<string name="description">Shout Applies Echo Dot To Foes</string>

			<array name="description-params">
				<array><s>Echo</s><s>stacks</s><s>2</s><s>4</s><s>6</s></array>
			</array>

			<array name="icon">
				<string>players/arbalest/icons_skills.png</string>
				<int>100</int><vec4>72 24 24 24</vec4>
			</array>

			<string name="id">arbalest_morale_booster_echo</string>

			<dict name="skill">
				<dict name="binds">
					<int name="echo-stacks">2</int>
				</dict>

			</dict>

			<array name="upgrades">
				<dict>
					<string name="quality">uncommon</string>
					<dict name="binds">
						<int name="echo-stacks">4</int>
					</dict>
				</dict>
				<dict>
					<string name="quality">rare</string>
					<dict name="binds">
						<int name="echo-stacks">6</int>
					</dict>
				</dict>

			</array>
		</dict>

	</array>
</dict>