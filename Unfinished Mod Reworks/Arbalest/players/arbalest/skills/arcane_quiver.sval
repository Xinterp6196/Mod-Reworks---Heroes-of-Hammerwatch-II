%include "players/skills_cost.inc"
<dict>
	<string name="name">Arcane Quiver</string>
	<string name="type-name">.skills.type.passive</string>
	<string name="description">Every fourth weapon skill cast launches a homing Magic Missile at a nearby enemy. This scales with your Weapon Damage and not Spellpower.</string>
	<array name="description-params">
		<array><s>attacks</s><s>Weapon casts per trigger</s><s>4</s></array>
	</array>

	<array name="icon">
		<string>players/arbalest/icons_skills.png</string>
		<int>100</int><vec4>24 0 24 24</vec4>
	</array>

	<string name="id">arbalest_arcane_quiver</string>
	<array name="tags"><s>passive</s></array>
	<int name="starting-level">1</int>

	<dict name="skill">
