<unit netsync="none">
	<behavior class="NewProjectile">
		<string name="anim">default</string>
		<float name="speed">12</float>
		<int name="ttl">800</int>
		<int name="penetration">999</int>
		<int name="bounces">0</int>
		<bool name="bounce-on-collide">false</bool>

		<array name="modifiers">
			<dict>
				<string name="class">Projectile::GroundBouncing</string>
				<int name="period">300</int>
				<int name="height">6</int>
				<int name="bounces">0</int>
				<bool name="hit-target">true</bool>
				<bool name="hit-target-scale-speed">true</bool>
				<array name="effects">
					<dict>
						<string name="class">PlaySound</string>
						<string name="sound">event:/sfx/player/classes/rogue/grenade/grenade_bounce</string>
					</dict>
					<dict>
						<string name="class">SpawnEffect</string>
						<string name="effect">effects/generic/impacts/dust_ground_small_1.effect</string>
					</dict>
				</array>
			</dict>
			<dict>
				<string name="class">Projectile::AttachedLoopingSound</string>
				<string name="sound">event:/sfx/player/classes/rogue/grenade/grenade_fuse</string>
			</dict>
		</array>

		<array name="destroyed-effects">
			<dict>
				<string name="class">SpawnUnit</string>
				<string name="unit-bind">proj-explode-unit</string>
			</dict>
		</array>

		<dict name="effect-params">
			<float name="height">5</float>
		</dict>
	</behavior>

	<scenes start="default">
		<scene name="default">
			<collision static="false">
				<circle radius="5" projectile="true" />
			</collision>
			<scene pos="-3 4" src="special/shadow.unit:8" />
			<effect src="players/rogue/projectiles/grenade_throw.effect?scale=1" />
		</scene>
	</scenes>
</unit>
