<unit layer="1">
	<behavior class="DangerAreaBehaviorP">
		<int name="freq">500</int>
		<string name="ttl-bind">area-ttl</string>
		<string name="sound-loop">event:/sfx/player/classes/rogue/toxic_cloud/toxic_cloud_loop</string>
		
		<array name="effects">
			<dict>
				<float name="self-dmg">1</float>
				<float name="team-dmg">1</float>
				<float name="enemy-dmg">0</float>
			</dict>
			<dict>
				<string name="class">ApplyBuff</string>
				<string name="buff-bind">area-buff</string>
			</dict>
			<dict>
				<float name="self-dmg">0</float>
				<float name="team-dmg">0</float>
				<float name="enemy-dmg">1</float>
			</dict>
			<dict>
				<string name="class">Damage</string>
				<string name="poison-bind">area-poison-dmg</string>
				<bool name="true-strike">true</bool>
			</dict>
			<dict>
				<string name="class">ApplyBuff</string>
				<string name="buff-bind">area-debuff</string>
			</dict>
			<dict>
				<string name="class">ApplyBuff</string>
				<string name="buff-bind">area-blind-buff</string>
				<string name="chance-bind">area-blind-chance</string>
			</dict>
		</array>
	</behavior>

	<scenes>
		<scene>
			<collision static="false">
				<circle radius="150" sensor="true" shoot-through="true" aim-through="false" />
			</collision>
			<effect src="players/rogue/effects/rog_toxic_cloud_start.effect?cg=0.4&amp;cr=0.3&amp;cb=0.1" />
			<effect delay="150" src="players/rogue/effects/rog_toxic_cloud.effect?cg=0.4&amp;cr=0.3&amp;cb=0.1&amp;poison=1&amp;radius=150" />
		</scene>
	</scenes>
</unit>