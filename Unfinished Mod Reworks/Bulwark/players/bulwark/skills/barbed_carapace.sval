%include "players/skills_cost.inc"
<dict>
	<string name="name">Barbed Carapace</string>
	<string name="type-name">.skills.type.passive</string>
	<string name="description">Increase thorns and improve their scaling. Each point of Strength also grants 0.25 thorns.</string>

	<array name="description-params">
		<array><s>thorns</s><s>thorns</s><s>5</s><s>10</s><s>15</s><s>20</s><s>25</s></array>
		<array><s>thorns-increase</s><s>thorns increase</s><s>1%</s><s>2%</s><s>3%</s><s>4%</s><s>5%</s></array>
	</array>

	<array name="icon">
		<string>players/bulwark/icons_skills.png</string>
		<int>100</int><vec4>72 0 24 24</vec4>
	</array>

	<string name="id">bulwark_barbed_carapace</string>
	<array name="tags"><s>passive</s><s>physical</s></array>
	<int name="starting-level">1</int>

	<dict name="skill">
		<int name="skill-cost">SKILLCOSTLEVEL_1</int>
		<string name="class">Skills::PassiveSkill</string>
		<dict name="binds">
			<int name="thorns-add">5</int>
			<float name="thorns-mul">0.01</float>
		</dict>
		<array name="modifiers">
			<array>
				<dict>
					<string name="class">Modifiers::AddThorns</string>
					<string name="thorns-bind">thorns-add</string>
				</dict>
				<dict>
					<string name="class">Modifiers::ConvertStat</string>
					<string name="from">thorns</string>
					<string name="to">thorns</string>
					<string name="mul-bind">thorns-mul</string>
					<bool name="add">true</bool>
				</dict>
				<dict>
					<string name="class">Modifiers::ConvertStat</string>
					<string name="from">str</string>
					<string name="to">thorns</string>
					<vec2 name="mul">0.25 0.25</vec2>
					<bool name="add">true</bool>
				</dict>
			</array>
		</array>
	</dict>

	<array name="upgrades">
		<dict><int name="skill-cost">SKILLCOSTLEVEL_2</int><dict name="binds"><int name="thorns-add">10</int><float name="thorns-mul">0.02</float></dict></dict>
		<dict><int name="skill-cost">SKILLCOSTLEVEL_3</int><dict name="binds"><int name="thorns-add">15</int><float name="thorns-mul">0.03</float></dict></dict>
		<dict><int name="skill-cost">SKILLCOSTLEVEL_4</int><dict name="binds"><int name="thorns-add">20</int><float name="thorns-mul">0.04</float></dict></dict>
		<dict><int name="skill-cost">SKILLCOSTLEVEL_5</int><dict name="binds"><int name="thorns-add">25</int><float name="thorns-mul">0.05</float></dict></dict>
	</array>

	<array name="modifier-skills">
		<dict>
			<string name="name">Ranged Guard</string>
			<string name="description">Gain a chance to block ranged attacks.</string>
			<array name="description-params"><array><s>chance</s><s>chance</s><s>15%</s><s>30%</s><s>45%</s></array></array>
			<array name="icon"><string>players/bulwark/icons_skills.png</string><int>100</int><vec4>72 0 24 24</vec4></array>
			<string name="id">bulwark_barbed_carapace_ranged_block</string>
			<dict name="skill">
				<dict name="binds"><float name="block-chance">0.15</float></dict>
				<array name="modifiers">
					<array><null /></array>
					<array>
						<dict>
							<string name="class">Modifiers::Block</string>
							<string name="chance-bind">block-chance</string>
							<float name="any-based">1</float>
							<int name="arc">360</int>
							<bool name="only-projectile">true</bool>
						</dict>
					</array>
				</array>
			</dict>
			<array name="upgrades">
				<dict><string name="quality">uncommon</string><dict name="binds"><float name="block-chance">0.30</float></dict></dict>
				<dict><string name="quality">rare</string><dict name="binds"><float name="block-chance">0.45</float></dict></dict>
			</array>
		</dict>
		<dict>
			<string name="name">Arcane Guard</string>
			<string name="description">Gain a chance to block elemental and pure damage.</string>
			<array name="description-params"><array><s>chance</s><s>chance</s><s>15%</s><s>30%</s><s>45%</s></array></array>
			<array name="icon"><string>players/bulwark/icons_skills.png</string><int>100</int><vec4>72 0 24 24</vec4></array>
			<string name="id">bulwark_barbed_carapace_magic_block</string>
			<dict name="skill">
				<dict name="binds"><float name="block-chance">0.15</float></dict>
				<array name="modifiers">
					<array><null /></array>
					<array>
						<dict>
							<string name="class">Modifiers::Block</string>
							<string name="chance-bind">block-chance</string>
							<float name="fire-based">1</float>
							<float name="ice-based">1</float>
							<float name="lightning-based">1</float>
							<float name="poison-based">1</float>
							<float name="pure-based">1</float>
							<int name="arc">360</int>
						</dict>
					</array>
				</array>
			</dict>
			<array name="upgrades">
				<dict><string name="quality">uncommon</string><dict name="binds"><float name="block-chance">0.30</float></dict></dict>
				<dict><string name="quality">rare</string><dict name="binds"><float name="block-chance">0.45</float></dict></dict>
			</array>
		</dict>
		<dict>
			<string name="name">Thorn-Plated</string>
			<string name="description">Gain armor based on your thorns value.</string>
			<array name="description-params"><array><s>armor</s><s>armor per thorns</s><s>25%</s><s>50%</s><s>75%</s></array></array>
			<array name="icon"><string>players/bulwark/icons_skills.png</string><int>100</int><vec4>72 0 24 24</vec4></array>
			<string name="id">bulwark_barbed_carapace_armor</string>
			<dict name="skill">
				<dict name="binds"><float name="armor-per-thorn">0.25</float></dict>
				<array name="modifiers">
					<array><null /></array>
					<array>
						<dict>
							<string name="class">Modifiers::StatBasedBonus</string>
							<string name="stat">thorns</string>
							<string name="armor-bind">armor-per-thorn</string>
						</dict>
					</array>
				</array>
			</dict>
			<array name="upgrades">
				<dict><string name="quality">uncommon</string><dict name="binds"><float name="armor-per-thorn">0.50</float></dict></dict>
				<dict><string name="quality">rare</string><dict name="binds"><float name="armor-per-thorn">0.75</float></dict></dict>
			</array>
		</dict>
	</array>
</dict>
