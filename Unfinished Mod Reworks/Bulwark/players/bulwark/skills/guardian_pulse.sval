				<string name="guard-buff">players/bulwark/buffs_bulwark.sval:guard_4</string>
			</dict>
		</dict>
		<dict>
			<int name="skill-cost">SKILLCOSTLEVEL_5</int>
			<int name="mana-cost">28</int>
			<dict name="binds">
				<int name="base-damage">120</int>
				<float name="thorns-percent">0.8</float>
				<string name="guard-buff">players/bulwark/buffs_bulwark.sval:guard_5</string>
			</dict>
		</dict>
	</array>

	<array name="modifier-skills">
		<dict>
			<string name="name">Steady Recovery</string>
			<string name="description">Guardian Pulse grants health regeneration to allies for its duration.</string>
			<array name="description-params"><array><s>regen</s><s>Health regeneration</s><s>4</s><s>8</s><s>12</s></array></array>
			<array name="icon"><string>players/bulwark/icons_skills.png</string><int>100</int><vec4>24 24 24 24</vec4></array>
			<string name="id">bulwark_guardian_pulse_regen</string>
			<dict name="skill"><dict name="binds"><string name="regen-buff">players/bulwark/buffs_bulwark.sval:regen_4</string></dict></dict>
			<array name="upgrades">
				<dict><string name="quality">uncommon</string><dict name="binds"><string name="regen-buff">players/bulwark/buffs_bulwark.sval:regen_8</string></dict></dict>
				<dict><string name="quality">rare</string><dict name="binds"><string name="regen-buff">players/bulwark/buffs_bulwark.sval:regen_12</string></dict></dict>
			</array>
		</dict>
		<dict>
			<string name="name">Serrated Pulse</string>
			<string name="description">Guardian Pulse applies bleeding to damaged enemies.</string>
			<array name="description-params"><array><s>stacks</s><s>Stacks</s><s>1</s><s>2</s><s>3</s></array></array>
			<array name="icon"><string>players/bulwark/icons_skills.png</string><int>100</int><vec4>24 24 24 24</vec4></array>
			<string name="id">bulwark_guardian_pulse_bleed</string>
