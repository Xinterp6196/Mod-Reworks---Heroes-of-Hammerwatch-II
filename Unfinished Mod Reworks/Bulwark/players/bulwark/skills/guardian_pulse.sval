%include "players/skills_cost.inc"
<dict>
	<string name="name">Guardian Pulse</string>
	<string name="type-name">.skills.type.spell</string>
	<string name="description">Deal base physical damage plus damage based on your thorns to nearby enemies, and grant nearby allies damage reduction for 8 seconds.</string>

	<array name="description-params">
		<array><s>base-damage</s><s>Base damage</s><s>40</s><s>60</s><s>80</s><s>100</s><s>120</s></array>
		<array><s>damage</s><s>Damage</s><s>20%</s><s>35%</s><s>50%</s><s>65%</s><s>80%</s></array>
		<array><s>reduction</s><s>Damage reduction</s><s>2%</s><s>4%</s><s>6%</s><s>8%</s><s>10%</s></array>
		<array><s>mana-cost</s><s>.skills.desc.params.mana_cost</s><s>28</s></array>
		<array><s>duration</s><b>t</b><s>.skills.desc.params.duration</s><s>8s</s></array>
		<array><s>cooldown</s><b>t</b><s>.skills.desc.params.cooldown</s><s>6s</s></array>
	</array>

	<array name="icon">
		<string>players/bulwark/icons_skills.png</string>
		<int>100</int><vec4>24 24 24 24</vec4>
	</array>

	<string name="id">bulwark_guardian_pulse</string>
	<string name="type">spell</string>
	<array name="tags"><s>spell</s><s>physical</s></array>
	<int name="starting-level">1</int>

	<dict name="skill">
		<int name="skill-cost">SKILLCOSTLEVEL_1</int>
		<string name="class">Skills::PlayerSkillDirectional</string>
		<string name="anim">cast</string>
		<int name="anim-length">600</int>
		<int name="cooldown">6000</int>
		<int name="castpoint">150</int>
		<float name="cast-speed-mul">1</float>
		<float name="move-speed-mul">0.7</float>
		<ivec2 name="move-speed">0 250</ivec2>
		<ivec2 name="blocking">0 250</ivec2>
		<bool name="repeating">false</bool>
		<int name="mana-cost">28</int>

		<dict name="binds">
			<int name="base-damage">40</int>
			<float name="thorns-percent">0.2</float>
			<string name="guard-buff">players/bulwark/buffs_bulwark.sval:guard_1</string>
			<string name="regen-buff">players/bulwark/buffs_bulwark.sval:noop</string>
			<string name="haste-buff">players/bulwark/buffs_bulwark.sval:noop</string>
			<int name="bleed-stacks">0</int>
		</dict>

		<dict name="actions">
			<array name="pre">
				<dict>
					<string name="class">SpawnEffect</string>
					<string name="effect">players/warrior/effects/warcry.effect</string>
					<bool name="attach-to-owner">true</bool>
				</dict>
				<dict>
					<string name="class">PlaySound</string>
					<string name="sound">event:/sfx/player/classes/paladin/blessed_strike/blessed_strike_cast</string>
				</dict>
			</array>
			<array name="cast">
				<dict>
					<string name="class">PlaySound</string>
					<string name="sound">event:/sfx/player/classes/paladin/blessed_strike/blessed_strike_impact</string>
				</dict>
				<dict>
					<string name="class">SpawnEffect</string>
					<string name="effect">players/paladin/effects/blessed_strike.effect?radius=24</string>
				</dict>
				<dict>
					<string name="class">Explode</string>
					<string name="fx">players/bulwark/effects/guardian_pulse_area.effect?radius=120</string>
					<int name="radius">120</int>
					<int name="min-radius">100</int>
					<float name="dist-scaling">1000</float>
					<bool name="hit-self">true</bool>
					<bool name="hit-same-team">true</bool>
					<bool name="hit-different-team">true</bool>
					<array name="effects">
						<dict>
							<float name="self-dmg">1</float>
							<float name="team-dmg">1</float>
							<float name="enemy-dmg">0</float>
							<bool name="only-actors">true</bool>
						</dict>
						<dict>
							<string name="class">ApplyBuff</string>
							<string name="buff-bind">guard-buff</string>
						</dict>
						<dict>
							<string name="class">ApplyBuff</string>
							<string name="buff-bind">regen-buff</string>
						</dict>
						<dict>
							<float name="self-dmg">1</float>
							<float name="team-dmg">0</float>
							<float name="enemy-dmg">0</float>
							<bool name="only-actors">true</bool>
						</dict>
						<dict>
							<string name="class">ApplyBuff</string>
							<string name="buff-bind">haste-buff</string>
						</dict>
						<dict>
							<float name="self-dmg">0</float>
							<float name="team-dmg">0</float>
							<float name="enemy-dmg">1</float>
							<bool name="only-actors">true</bool>
						</dict>
						<dict>
							<string name="class">Damage</string>
							<string name="physical-bind">base-damage</string>
						</dict>
						<dict>
							<string name="class">StatBasedDamage</string>
							<string name="type">physical</string>
							<string name="stat">thorns</string>
							<string name="amount-bind">thorns-percent</string>
						</dict>
						<dict>
							<string name="class">AddStacks</string>
							<string name="buff">tweak/buffs/stacks_bulwark.sval:bulwark_bleeding</string>
							<string name="stacks-bind">bleed-stacks</string>
							<float name="chance">1</float>
							<bool name="target-self">false</bool>
						</dict>
					</array>
				</dict>
			</array>
		</dict>

		<array name="timeline">
			<i>0</i><s>pre</s>
			<i>150</i><s>cast</s>
		</array>
	</dict>

	<array name="upgrades">
		<dict>
			<int name="skill-cost">SKILLCOSTLEVEL_2</int>
