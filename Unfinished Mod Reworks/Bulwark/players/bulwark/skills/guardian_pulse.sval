				<dict><string name="quality">uncommon</string><dict name="binds"><int name="bleed-stacks">2</int></dict></dict>
				<dict><string name="quality">rare</string><dict name="binds"><int name="bleed-stacks">3</int></dict></dict>
			</array>
		</dict>
		<dict>
			<string name="name">Tempered Strike</string>
			<string name="description">Guardian Pulse grants you increased attack speed for its duration.</string>
			<array name="description-params"><array><s>speed</s><s>Attack speed</s><s>10%</s><s>20%</s><s>30%</s></array></array>
			<array name="icon"><string>players/bulwark/icons_skills.png</string><int>100</int><vec4>24 24 24 24</vec4></array>
