				<dict><string name="quality">rare</string><dict name="binds"><float name="fourth-echo-chance">1</float></dict></dict>
			</array>
		</dict>
		<dict>
			<string name="name">Thorn Resonance</string>
			<string name="description">Each echo gains additional pure damage based on your thorns.</string>
			<array name="description-params"><array><s>bonus</s><s>Thorns added</s><s>33%</s><s>66%</s><s>100%</s></array></array>
			<array name="icon"><string>players/bulwark/icons_skills.png</string><int>100</int><vec4>96 0 24 24</vec4></array>
			<string name="id">bulwark_echoing_assault_thorns</string>
			<dict name="skill"><dict name="binds"><float name="thorns-echo-bonus">0.33</float></dict></dict>
			<array name="upgrades">
				<dict><string name="quality">uncommon</string><dict name="binds"><float name="thorns-echo-bonus">0.66</float></dict></dict>
				<dict><string name="quality">rare</string><dict name="binds"><float name="thorns-echo-bonus">1</float></dict></dict>
			</array>
		</dict>
		<dict>
			<string name="name">Thorn-Fed Vitality</string>
			<string name="description">Gain maximum health based on your thorns.</string>
			<array name="description-params"><array><s>health</s><s>Health from thorns</s><s>15%</s><s>30%</s><s>45%</s></array></array>
			<array name="icon"><string>players/bulwark/icons_skills.png</string><int>100</int><vec4>96 0 24 24</vec4></array>
			<string name="id">bulwark_echoing_assault_vitality</string>
			<dict name="skill">
				<dict name="binds"><float name="thorns-health-mul">0.15</float></dict>
				<array name="modifiers">
					<array><null /></array>
					<array>
						<dict>
							<string name="class">Modifiers::ConvertStat</string>
							<string name="from">thorns</string>
							<string name="to">health</string>
							<string name="mul-bind">thorns-health-mul</string>
							<bool name="add">true</bool>
						</dict>
					</array>
				</array>
			</dict>
			<array name="upgrades">
				<dict><string name="quality">uncommon</string><dict name="binds"><float name="thorns-health-mul">0.30</float></dict></dict>
				<dict><string name="quality">rare</string><dict name="binds"><float name="thorns-health-mul">0.45</float></dict></dict>
			</array>
		</dict>
	</array>
</dict>
