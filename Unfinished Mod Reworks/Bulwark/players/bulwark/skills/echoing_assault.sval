							<bool name="true-strike">true</bool>
						</dict>
					</array>
				</dict>
			</array>
		</array>
	</dict>

	<array name="upgrades">
		<dict><int name="skill-cost">SKILLCOSTLEVEL_2</int><dict name="binds"><vec2 name="attack-multiplier">0.85 0.85</vec2><float name="echo-percent">0.14</float></dict></dict>
		<dict><int name="skill-cost">SKILLCOSTLEVEL_3</int><dict name="binds"><vec2 name="attack-multiplier">0.85 0.85</vec2><float name="echo-percent">0.18</float></dict></dict>
		<dict><int name="skill-cost">SKILLCOSTLEVEL_4</int><dict name="binds"><vec2 name="attack-multiplier">0.85 0.85</vec2><float name="echo-percent">0.22</float></dict></dict>
		<dict><int name="skill-cost">SKILLCOSTLEVEL_5</int><dict name="binds"><vec2 name="attack-multiplier">0.85 0.85</vec2><float name="echo-percent">0.26</float></dict></dict>
	</array>

	<array name="modifier-skills">
		<dict>
			<string name="name">Repeated Reprisal</string>
			<string name="description">Echo each attack an additional 1, 2, or 3 times.</string>
			<array name="description-params"><array><s>echoes</s><s>Echoes</s><s>1</s><s>2</s><s>3</s></array></array>
			<array name="icon"><string>players/bulwark/icons_skills.png</string><int>100</int><vec4>96 0 24 24</vec4></array>
			<string name="id">bulwark_echoing_assault_repeats</string>
			<dict name="skill">
				<dict name="binds"><float name="second-echo-chance">1</float></dict>
			</dict>
			<array name="upgrades">
