%include "players/skills_cost.inc"
<dict>
	<string name="name">Echoing Assault</string>
	<string name="type-name">.skills.type.passive</string>
	<string name="description">Your raw attacks deal less damage, but repeat as an unavoidable echo. Damage-over-time, thorns, and reflected damage do not trigger echoes.</string>

	<array name="description-params">
		<array><s>damage-reduction</s><s>Attack damage reduction</s><s>15%</s><s>15%</s><s>15%</s><s>15%</s><s>15%</s></array>
		<array><s>echo</s><s>Echo damage</s><s>10%</s><s>14%</s><s>18%</s><s>22%</s><s>26%</s></array>
	</array>

	<array name="icon">
		<string>players/bulwark/icons_skills.png</string>
		<int>100</int><vec4>96 0 24 24</vec4>
	</array>

	<string name="id">bulwark_echoing_assault</string>
	<array name="tags"><s>passive</s><s>physical</s></array>
	<int name="starting-level">1</int>

	<dict name="skill">
