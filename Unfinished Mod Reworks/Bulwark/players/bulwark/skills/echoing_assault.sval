						</dict>
						<dict>
							<string name="class">StatBasedDamage</string>
							<string name="type">pure</string>
							<string name="stat">thorns</string>
							<string name="amount-bind">thorns-echo-bonus</string>
							<bool name="true-strike">true</bool>
						</dict>
					</array>
				</dict>
				<dict>
					<string name="class">Modifiers::SkillTriggerEffect</string>
					<string name="skill-type">mainhand</string>
					<string name="trigger">hit</string>
					<bool name="target-self">false</bool>
