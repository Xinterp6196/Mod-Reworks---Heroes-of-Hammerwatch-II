%include "players/skills_cost.inc"
<dict>
	<string name="name">Stonebreak</string>
	<string name="type-name">.skills.type.passive</string>
	<string name="description">Melee attacks send a physical, thorns-powered shock through the ground. Gaseous Sunder adds poison, while Grounding Pulse restores a small amount of health after melee attacks.</string>
	<array name="description-params">
		<array><s>damage</s><s>Thorns damage</s><s>20%</s><s>25%</s><s>30%</s><s>35%</s><s>40%</s></array>
		<array><s>effectcd</s><s>.skills.desc.params.cooldown.effect</s><s>2.5s</s><s>2s</s><s>1.5s</s><s>1s</s><s>0.5s</s></array>
	</array>
	<array name="icon"><string>players/bulwark/icons_skills.png</string><int>100</int><vec4>72 64 24 24</vec4></array>
	<string name="id">bulwark_stonebreak</string>
	<array name="tags"><s>passive</s><s>physical</s></array>
	<int name="starting-level">1</int>
	<dict name="skill">
		<int name="skill-cost">SKILLCOSTMASTERYLEVEL_1</int>
		<string name="class">Skills::PassiveSkill</string>
		<dict name="binds"><float name="stonebreak-thorns-mul">0.20</float><int name="effect-cd">2500</int><float name="grounding-pulse-heal">0</float><int name="stonebreak-bleed-stacks">0</int><int name="stonebreak-poison-stacks">0</int></dict>
		<array name="modifiers">
			<array>
				<dict>
					<string name="class">Modifiers::SkillTriggerEffect</string>
					<array name="skill-tags"><s>melee</s></array>
					<string name="trigger">attack</string>
					<bool name="target-self">true</bool>
					<float name="chance">1</float>
					<string name="timeout-bind">effect-cd</string>
					<array name="effects">
						<dict>
							<string name="class">PlaySound</string>
							<string name="sound">event:/sfx/player/classes/warrior/tremor_strikes/tremor_strikes</string>
						</dict>
						<dict><string name="class">SpawnEffect</string><string name="effect">effects/generic/other/rock_shard.effect</string></dict>
						<dict>
							<string name="class">Explode</string>
							<string name="fx">players/warrior/effects/tremor_strike.effect?radius=40</string>
							<int name="radius">40</int>
							<int name="min-radius">8</int>
							<float name="dist-scaling">1000</float>
							<array name="effects">
								<dict><string name="class">StatBasedDamage</string><string name="type">physical</string><string name="stat">thorns</string><string name="amount-bind">stonebreak-thorns-mul</string></dict>
								<dict><string name="class">AddStacks</string><string name="buff">tweak/buffs/stacks_bulwark.sval:bulwark_bleeding</string><string name="stacks-bind">stonebreak-bleed-stacks</string><float name="chance">1</float></dict>
								<dict><string name="class">AddStacks</string><string name="buff">tweak/buffs/stacks_bulwark.sval:bulwark_poison</string><string name="stacks-bind">stonebreak-poison-stacks</string><float name="chance">1</float></dict>
							</array>
						</dict>
					</array>
				</dict>
				<dict>
					<string name="class">Modifiers::SkillTriggerEffect</string>
					<array name="skill-tags"><s>melee</s></array>
					<string name="trigger">attack</string>
					<bool name="target-self">true</bool>
					<float name="chance">1</float>
					<int name="timeout">3000</int>
					<array name="effects">
						<dict><string name="class">HPBasedHeal</string><string name="heal-bind">grounding-pulse-heal</string><bool name="curr-hp">false</bool></dict>
					</array>
				</dict>
			</array>
		</array>
	</dict>
	<array name="upgrades">
		<dict><int name="skill-cost">SKILLCOSTMASTERYLEVEL_2</int><dict name="binds"><float name="stonebreak-thorns-mul">0.25</float><int name="effect-cd">2000</int></dict></dict>
		<dict><int name="skill-cost">SKILLCOSTMASTERYLEVEL_3</int><dict name="binds"><float name="stonebreak-thorns-mul">0.30</float><int name="effect-cd">1500</int></dict></dict>
		<dict><int name="skill-cost">SKILLCOSTMASTERYLEVEL_4</int><dict name="binds"><float name="stonebreak-thorns-mul">0.35</float><int name="effect-cd">1000</int></dict></dict>
		<dict><int name="skill-cost">SKILLCOSTMASTERYLEVEL_5</int><dict name="binds"><float name="stonebreak-thorns-mul">0.40</float><int name="effect-cd">500</int></dict></dict>
	</array>
	<array name="modifier-skills">
		<dict>
			<string name="name">Grounding Pulse</string>
			<string name="description">Melee attacks restore a small portion of your maximum health. Can trigger once every 3 seconds.</string>
			<array name="description-params"><array><s>heal</s><s>Maximum health restored</s><s>1%</s><s>1.5%</s><s>2%</s></array></array>
			<array name="icon"><string>players/bulwark/icons_skills.png</string><int>100</int><vec4>72 64 24 24</vec4></array>
			<string name="id">bulwark_stonebreak_heal</string>
			<dict name="skill"><dict name="binds"><float name="grounding-pulse-heal">0.01</float></dict></dict>
			<array name="upgrades">
				<dict><string name="quality">uncommon</string><dict name="binds"><float name="grounding-pulse-heal">0.015</float></dict></dict>
				<dict><string name="quality">rare</string><dict name="binds"><float name="grounding-pulse-heal">0.02</float></dict></dict>
			</array>
		</dict>
		<dict>
			<string name="name">Splintering Fault</string>
			<string name="description">Stonebreak applies bleeding to enemies struck by its shockwave.</string>
			<array name="description-params"><array><s>stacks</s><s>Bleeding stacks</s><s>1</s><s>2</s><s>3</s></array></array>
			<array name="icon"><string>players/bulwark/icons_skills.png</string><int>100</int><vec4>72 64 24 24</vec4></array>
			<string name="id">bulwark_stonebreak_bleed</string>
			<dict name="skill"><dict name="binds"><int name="stonebreak-bleed-stacks">1</int></dict></dict>
			<array name="upgrades">
				<dict><string name="quality">uncommon</string><dict name="binds"><int name="stonebreak-bleed-stacks">2</int></dict></dict>
				<dict><string name="quality">rare</string><dict name="binds"><int name="stonebreak-bleed-stacks">3</int></dict></dict>
			</array>
		</dict>
		<dict>
			<string name="name">Gaseous Sunder</string>
			<string name="description">Stonebreak applies stacking poison to enemies struck by its shockwave.</string>
			<array name="description-params"><array><s>stacks</s><s>Poison stacks</s><s>1</s><s>2</s><s>3</s></array></array>
			<array name="icon"><string>players/bulwark/icons_skills.png</string><int>100</int><vec4>72 64 24 24</vec4></array>
			<string name="id">bulwark_stonebreak_poison</string>
			<dict name="skill"><dict name="binds"><int name="stonebreak-poison-stacks">1</int></dict></dict>
			<array name="upgrades">
				<dict><string name="quality">uncommon</string><dict name="binds"><int name="stonebreak-poison-stacks">2</int></dict></dict>
				<dict><string name="quality">rare</string><dict name="binds"><int name="stonebreak-poison-stacks">3</int></dict></dict>
			</array>
		</dict>
	</array>
</dict>
