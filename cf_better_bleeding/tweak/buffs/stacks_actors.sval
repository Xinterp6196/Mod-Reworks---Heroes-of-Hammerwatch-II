						<string name="class">Damage</string>
						<int name="physical">8</int>
						<bool name="true-strike">true</bool>
						<bool name="dot">true</bool>
					</dict>
					<dict>
						<string name="class">SpawnEffect</string>
						<string name="effect">effects/generic/actor/actor_blood_loss.effect</string>
					</dict>
				</array>
			</dict>
		</dict>
	</dict>
	

	<dict>
